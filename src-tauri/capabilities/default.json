{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.github.com/graphql"
        },
        {
          "url": "https://leetcode.com/graphql"
        }
      ]
    },
    "shell:default",
    "core:window:allow-start-dragging",
    "http:default",
    "sql:default"
  ]
}